# ============================================================================
# SUPPER CLUB DIRECT — backend environment (copy to .env)
# ============================================================================

# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://user:pass@localhost:5432/supperclub?schema=public"

# --- Payments: Stripe (REQUIRED to go live; demo works without) ---
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --- Delivery providers (REQUIRED to go live; demo works without) ---
# Uber Direct white-label courier token
UBER_DIRECT_TOKEN="..."
# OrderOut aggregator API key (routes to cheapest provider, auto-failover)
ORDEROUT_API_KEY="..."

# --- Auth / JWT (REQUIRED in production — set a strong random value) ---
JWT_SECRET="change-me-to-a-long-random-secret"

# --- Server ---
PORT=4000
